rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Catch-all to deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow update: if isOwner(userId); // Simplified for prototype
      allow create: if isOwner(userId);
    }

    // Users History subcollection
    match /users/{userId}/history/{historyId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // Marketplace collection
    match /marketplace/{listingId} {
      allow read: if true; // Public read
      allow write: if isSignedIn(); // Any signed in user can create a listing
    }
  }
}
