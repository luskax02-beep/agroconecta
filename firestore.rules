rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      // In a real app, verify against an 'admins' collection.
      // For this simple landing page, assuming any authenticated user is an admin
      // since we only provision email/password for the site owner.
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Validation Helpers
    function isValidOrder(data) {
      return data.keys().hasAll(['items', 'total', 'createdAt', 'status'])
        && data.keys().size() == 4
        && data.items is string && data.items.size() > 0 && data.items.size() <= 4096 /* Serialized JSON carts are fine up to 4KB */
        && data.total is number && data.total >= 0
        && data.status in ['pending', 'completed'];
    }

    // Orders Collection
    match /orders/{orderId} {
      // Admins can read all orders
      allow read: if isAdmin();
      
      // Anyone can submit an order request (Create only)
      allow create: if isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().createdAt == request.time
        && incoming().status == 'pending';
        
      // Only admins can update (e.g., to change status)
      allow update: if isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly(['status'])
        && incoming().status in ['pending', 'completed']
        && incoming().items == existing().items
        && incoming().total == existing().total
        && incoming().createdAt == existing().createdAt;
        
      // Only admins can delete
      allow delete: if isAdmin();
    }
  }
}
