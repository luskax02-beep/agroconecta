rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      // In a real app, verify against an 'admins' collection.
      // For this simple landing page, assuming any authenticated user is an admin
      // since we only provision email/password for the site owner.
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Validation Helpers
    function isValidQuote(data) {
      return data.keys().hasAll(['name', 'whatsapp', 'areaAndLocation', 'createdAt', 'status'])
        && data.keys().size() == 5
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.whatsapp is string && data.whatsapp.size() > 0 && data.whatsapp.size() <= 20
        && data.areaAndLocation is string && data.areaAndLocation.size() > 0 && data.areaAndLocation.size() <= 200
        && data.status in ['pending', 'contacted'];
    }

    // Quotes Collection
    match /quotes/{quoteId} {
      // Admins can read all quotes
      allow read: if isAdmin();
      
      // Anyone can submit a quote request (Create only)
      allow create: if isValidId(quoteId)
        && isValidQuote(incoming())
        && incoming().createdAt == request.time
        && incoming().status == 'pending';
        
      // Only admins can update (e.g., to change status)
      allow update: if isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly(['status'])
        && incoming().status in ['pending', 'contacted']
        && incoming().name == existing().name
        && incoming().whatsapp == existing().whatsapp
        && incoming().areaAndLocation == existing().areaAndLocation
        && incoming().createdAt == existing().createdAt;
        
      // Only admins can delete
      allow delete: if isAdmin();
    }
  }
}
