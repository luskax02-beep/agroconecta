{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "An order composed of checkout items",
      "type": "object",
      "properties": {
        "items": { "type": "string", "description": "JSON serialized string of the cart items" },
        "total": { "type": "number", "description": "Total order price" },
        "status": { "type": "string", "enum": ["pending", "completed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["items", "total", "status", "createdAt"]
    }
  },
  "firestore": {
    "orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Orders submitted directly by users."
    }
  }
}
