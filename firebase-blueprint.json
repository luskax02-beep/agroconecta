{
  "entities": {
    "Quote": {
      "title": "Quote Request",
      "description": "A lead requesting an agronomic quote.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Full name of the requester", "maxLength": 100 },
        "whatsapp": { "type": "string", "description": "WhatsApp number", "maxLength": 20 },
        "areaAndLocation": { "type": "string", "description": "Area size and location", "maxLength": 200 },
        "createdAt": { "type": "timestamp" },
        "status": { "type": "string", "enum": ["pending", "contacted"], "description": "Status of the lead" }
      },
      "required": ["name", "whatsapp", "areaAndLocation", "createdAt", "status"]
    }
  },
  "firestore": {
    "quotes/{quoteId}": {
      "schema": { "$ref": "#/entities/Quote" },
      "description": "Collection of quote requests."
    }
  }
}
